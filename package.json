{
  "name": "dsh-global-todo",
  "version": "0.12.12",
  "icon": "./docs/icon.svg",
  "description": "Cross-session todo list for DeepSeek Harness: one JSON file a person and an agent both write to, with step plans that ship as a numbered hand-off, session read-back, and a human confirmation before an agent's \"done\" counts.",
  "type": "module",
  "license": "MIT",
  "author": "LUgABeEEE",
  "homepage": "https://lugabeeee.github.io/dsh-global-todo/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LUgABeEEE/dsh-global-todo.git"
  },
  "bugs": {
    "url": "https://github.com/LUgABeEEE/dsh-global-todo/issues"
  },
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "cordis",
    "todo",
    "todos",
    "todo-list",
    "task-list",
    "task-management",
    "handoff",
    "agent",
    "productivity",
    "待办",
    "全局待办"
  ],
  "engines": {
    "node": ">=22.19.0",
    "dsh": ">=0.2.0-rc.1 <0.3.0"
  },
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "lib",
    "locale",
    "cordis.patch.yml",
    "docs/DESIGN.md",
    "docs/DISTRIBUTION.md",
    "docs/ROADMAP.md",
    "docs/QUICKSTART.md",
    "docs/FAQ.md",
    "docs/WINDOWS.md",
    "docs/icon.svg",
    "docs/screenshots",
    "tools/doctor.mjs",
    "tools/doctor-lib.mjs",
    "!docs/screenshots/demo.mp4",
    "!docs/index.html",
    "!docs/assets",
    "LICENSE",
    "README.md",
    "README.zh.md",
    "CHANGELOG.md",
    "SECURITY.md",
    "CONTRIBUTING.md",
    "CODE_OF_CONDUCT.md"
  ],
  "bin": {
    "dsh-global-todo-doctor": "./tools/doctor.mjs"
  },
  "scripts": {
    "check": "node scripts/check.mjs",
    "doctor": "node tools/doctor.mjs",
    "check:windows": "node tools/windows-check.mjs",
    "notify": "node tools/notify.mjs",
    "test": "node --test \"test/**/*.test.mjs\"",
    "verify": "npm run check && npm run check:render && npm test",
    "preview": "node tools/preview.mjs",
    "screenshots": "npm run preview && node tools/screenshot.mjs",
    "tour": "node tools/tour.mjs",
    "prepack": "npm run verify",
    "check:render": "node tools/preview.mjs --check",
    "check:live": "node tools/live-check.mjs",
    "check:matrix": "node scripts/matrix.mjs"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  }
}
