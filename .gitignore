# Dependencies
node_modules/
.pnpm-store/

# Backup copies a plugin install or a person may create
*.bak-*
*.tmp
*.tgz

# Editor and OS noise
.DS_Store
Thumbs.db
.idea/
.vscode/

# Generated page fragment: written into the Pages artifact at deploy time, never committed
# (a bot commit on main would make the public tree differ from the private one)
docs/where.html

# Generated panel previews
preview/

# Local audit reports: written for the author, full of this machine's paths
reports/

# Local data: the list itself never belongs in the repository
todos.json
todos.json.*

# AgentTeams working state (task graph, mailboxes) is local to a session
.agent-teams/
